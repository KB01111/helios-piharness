# Server
PORT=4100
HOST=127.0.0.1
# Structured JSON log threshold: debug | info | warn | error (unknown values fall back to info)
LOG_LEVEL=info

# Storage (single-writer local SQLite files)
DATA_DIR=./data
PI_DB_PATH=./data/pi-durable.sqlite
APP_DB_PATH=./data/app-memory.sqlite
ARTIFACTS_DIR=./data/artifacts
SKILLS_DIR=./skills

# Models (@earendil-works/pi-ai)
# Use provider:modelId (e.g. anthropic:claude-sonnet-4-5, openai:gpt-4.1, google:gemini-2.5-flash)
# Or set USE_MOCK_MODELS=true for deterministic local testing without API keys
MAIN_MODEL=anthropic:claude-sonnet-4-5
FAST_MODEL=anthropic:claude-haiku-4-5
USE_MOCK_MODELS=false

# Provider API Keys (optional when USE_MOCK_MODELS=true)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Guardrails & Learning Loop Defaults
MAX_TOOL_OUTPUT_BYTES=6144
# Periodic sleep-cycle sweep (0 disables). Set SLEEP_CYCLE_SCHEDULER_ENABLED=false to turn it off explicitly.
SLEEP_CYCLE_CRON_INTERVAL_MS=300000
SLEEP_CYCLE_SCHEDULER_ENABLED=true
STALE_SKILL_DAYS=30

# HTTP auth & hardening (all /conversations, /approvals, /signals, /tool-packs, /usage routes require auth; /health is public)
# JSON map of bearer token -> identity, e.g. {"s3cret":{"tenantId":"acme","userId":"svc","permissions":["memory:read","admin:tool-packs"]}}
HELIOS_API_KEYS=
# DEV ONLY: trust x-tenant-id / x-user-id / x-permissions headers. Never enable on an exposed server.
HELIOS_AUTH_TRUSTED_HEADERS=false
HELIOS_MAX_BODY_BYTES=1048576
# Per-tenant requests per minute (0 disables)
HELIOS_RATE_LIMIT_PER_MINUTE=600
HELIOS_SSE_KEEPALIVE_MS=15000

# Budgets (0 = unlimited). A blocked generation ends the run as unanswered with a BUDGET_EXCEEDED detail.
MAX_CONVERSATION_TOKENS=0
MAX_CONVERSATION_COST_USD=0
MAX_TENANT_DAILY_TOKENS=0
MAX_TENANT_DAILY_COST_USD=0
# Background fast-model calls (memory consolidation, skill mining), all tenants combined, per UTC day. 0 = unlimited.
MAX_FAST_MODEL_DAILY_TOKENS=0
MAX_FAST_MODEL_DAILY_COST_USD=0
DEFAULT_MAX_TURNS=24

# Model resilience (main model uses Pi Durable's durable retry; fast model uses retry + circuit breaker + fallbacks)
MODEL_TIMEOUT_MS=120000
MODEL_MAX_RETRIES=3
MODEL_RETRY_BASE_DELAY_MS=2000
FAST_MODEL_TIMEOUT_MS=30000
FAST_MODEL_MAX_RETRIES=2
# Comma list of provider:model tried in order when the fast model fails
FAST_MODEL_FALLBACKS=
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_COOLDOWN_MS=30000
# Refuse to start with mock models when NODE_ENV=production unless true
ALLOW_MOCK_MODELS=false
HARNESS_STREAM_MAX_QUEUE=1000

# Codemode: the model writes JS that calls tools inside a QuickJS sandbox (guards/permissions still apply per call)
CODEMODE_ENABLED=true
CODEMODE_MEMORY_MB=128
CODEMODE_TIMEOUT_MS=120000
CODEMODE_MAX_WORKERS=4
CODEMODE_INLINE_BUDGET=3000

# Gated self-improvement: eval set root and approved prompt-improvement records
EVALS_DIR=./evals
# IMPROVEMENTS_DIR=./data/improvements

# Trace export: append every settled Pi Durable span (IDs/control metadata only) as JSONL; unset = off
# TRACE_EXPORT_PATH=./data/traces.jsonl
# TRACE_EXPORT_MAX_BYTES=52428800

# Answer verifier: a fast-model review before an answer stands (default on with real models, off with mocks)
# VERIFIER_ENABLED=true
# VERIFIER_MAX_REVISIONS=1
# VERIFIER_MIN_ANSWER_CHARS=600

# Self-improvement probing against real (non-deterministic) models: average several passes, forgive small tool-error-rate shifts
# IMPROVEMENT_PROBE_SAMPLES=3
# IMPROVEMENT_TOOL_ERROR_TOLERANCE=0.05

# Security, secret redaction & three-tier permission policy (allow | ask | deny)
SECRET_REDACTION_ENABLED=true
# Comma-separated tool names or globs (e.g. domain_mutate_record,mcp_prod__*) requiring durable human approval
TOOL_APPROVAL_REQUIRED=
# Comma-separated tool names or globs unconditionally blocked by policy
TOOL_DENIED=
TOOL_APPROVAL_TIMEOUT_MS=86400000

# Durable Subagents & Advisor (Builder-Verifier split, depth cap, permission narrowing)
SUBAGENTS_ENABLED=true
SUBAGENT_MAX_DEPTH=2
SUBAGENT_MAX_TURNS=8
SUBAGENT_MAX_PARALLEL=4
SUBAGENT_TIMEOUT_MS=120000
# Optional cheaper model for read-only researcher/reviewer subagents (defaults to MAIN_MODEL)
# SUBAGENT_READONLY_MODEL=anthropic:claude-haiku-4-5
# Optional advisor model for advisor_consult second opinions (defaults to FAST_MODEL)
# ADVISOR_MODEL=anthropic:claude-sonnet-4-5

# Lazy MCP Adapter & Deferred BM25 Tool Discovery
TOOL_SEARCH_ENABLED=true
# JSON array of MCP servers: [{"name":"docs","url":"https://mcp.example.com","headers":{"Authorization":"Bearer ..."},"readOnly":true}]
# MCP_SERVERS=[]

# Context Pruning & Plan/Artifact-Aware Structured Compaction
CONTEXT_PRUNE_ENABLED=true
CONTEXT_PRUNE_THRESHOLD_CHARS=32000
CONTEXT_PRUNE_KEEP_RECENT_TOOLS=6
STRUCTURED_COMPACTION_ENABLED=true

# Concurrent SSE stream caps and failed-auth throttling
# HELIOS_MAX_STREAMS=1000
# HELIOS_MAX_STREAMS_PER_TENANT=20
# HELIOS_AUTH_FAIL_LIMIT_PER_MINUTE=60
# Single-writer lock: when a lock held by another host may be reclaimed
# HELIOS_LOCK_STALE_MS=600000
# HELIOS_LOCK_FORCE_RECLAIM=false

# In-request SDK retries inside one model call (unset keeps the SDK default)
# MODEL_PROVIDER_MAX_RETRIES=2

# Data retention for append-only operational tables (days; 0 keeps forever)
RETENTION_ENABLED=true
RETENTION_INTERVAL_MS=21600000
RETENTION_PERMISSION_AUDIT_DAYS=365
RETENTION_TOOL_INVOCATION_DAYS=90
RETENTION_RUN_TELEMETRY_DAYS=90
RETENTION_BUDGET_EVENT_DAYS=30
RETENTION_BUDGET_DAILY_DAYS=400
# Opt-in: transcripts hold art_* recall handles that dangle once an artifact is deleted
RETENTION_ARTIFACT_DAYS=0

# ── Embeddings for hybrid memory retrieval (unset EMBEDDINGS_URL = lexical-only memory) ──
# Helios embedding server (npm run embed:server) or any OpenAI-compatible endpoint.
# EMBEDDINGS_URL=http://127.0.0.1:18765/v1
# EMBEDDINGS_API_KEY=
# Required for non-Helios endpoints, e.g. text-embedding-3-small with EMBEDDINGS_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=
# Matryoshka output size (EmbeddingGemma: 768/512/256/128); native when unset
# EMBEDDINGS_DIMENSIONS=
# EMBEDDINGS_TIMEOUT_MS=15000
# Fail startup instead of running lexical-only when the endpoint is unreachable
# EMBEDDINGS_REQUIRED=false
# Cross-encoder reranking of memory search (auto-discovered from a Helios EMBEDDINGS_URL; or a cloud rerank API)
# RERANK_ENABLED=true
# RERANK_URL=https://api.jina.ai/v1
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_API_KEY=
# RERANK_CANDIDATES=20

# ── Embedding server (npm run embed:server; see docs/embeddings.md) ──
# Profiles: gemma2 (EmbeddingGemma 2, in-process ONNX, default) | npu (FastFlowLM on Ryzen AI NPU) | openai | gemini
# EMBED_PROFILE=gemma2
# EMBED_HOST=127.0.0.1
# EMBED_PORT=18765
# Comma-separated bearer tokens; required when EMBED_HOST is not loopback
# EMBED_API_KEYS=
# EMBED_DIMENSIONS=
# EMBED_ONNX_DEVICE=cpu        # cpu | dml (DirectML, Radeon iGPU) | cuda | webgpu | auto
# EMBED_ONNX_DTYPE=q4          # q4 | q8 | fp16 | fp32 ...
# EMBED_NPU_URL=http://127.0.0.1:52625/v1
# EMBED_NPU_MODEL=embed-gemma:300m
# EMBED_NPU_AUTOSTART=false    # spawn `flm serve <EMBED_NPU_CHAT_MODEL> --embed 1` when not running
# EMBED_OPENAI_URL=https://api.openai.com/v1
# EMBED_OPENAI_MODEL=text-embedding-3-small
# EMBED_GEMINI_MODEL=gemini-embedding-001
# Quality self-test at startup (measures calibration, quarantines backends that cannot separate related text)
# Reranker: onnx (bge-reranker-v2-m3, default for gemma2/npu) | http (Jina/Cohere/Voyage) | off
# EMBED_RERANK=onnx
# EMBED_RERANK_MODEL=onnx-community/bge-reranker-v2-m3-ONNX
# EMBED_RERANK_URL=
# EMBED_RERANK_API_KEY=
# EMBED_SELF_TEST=true
# EMBED_SELF_TEST_ENFORCE=true
