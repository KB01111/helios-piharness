{
  "name": "helios-piharness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/evals/cli.ts",
    "eval:baseline": "tsx src/evals/cli.ts --update-baseline",
    "eval:live": "tsx src/evals/cli.ts --live",
    "bench:memory": "tsx benchmarks/run-memory-bench.ts",
    "embed:server": "tsx src/embeddings/main.ts",
    "embed:server:npu": "tsx src/embeddings/main.ts --profile npu --npu-autostart",
    "bench:memory:gate": "tsx benchmarks/run-memory-bench.ts --gate benchmarks/thresholds.json",
    "embed:server:cloud": "tsx src/embeddings/main.ts --profile openai",
    "bench:memory:gate:heldout": "tsx benchmarks/run-memory-bench.ts --dataset heldout --gate benchmarks/thresholds-heldout.json",
    "bench:public": "tsx benchmarks/run-public-bench.ts",
    "bench:files": "tsx benchmarks/run-file-search-bench.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@earendil-works/pi-telemetry": "1.6.0",
    "@hono/node-server": "2.1.11",
    "hono": "4.13.21"
  },
  "devDependencies": {
    "@types/node": "26.6.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.2"
  }
}
