    "scriptedResponses": [
      {
        "type": "tool_calls",
        "calls": [
          {
            "name": "memory_pin",
            "arguments": {
              "key": "pref.drink",
              "content": "Likes tea",
              "kind": "preference"
            }
          }
        ]
      },
      {
        "type": "text",
