        "domain:approve_request"
      ]
    },
    "evalPrompt": "What style of answers do I like?",
    "scriptedResponses": [
      {
        "type": "tool_calls",
        "calls": [
          {
            "name": "memory_search",
            "arguments": {
              "query": "answer style preference"
            }
          }
        ]
      },
      {
        "type": "text",
        "text": "Based on memory, you like concise answers."
