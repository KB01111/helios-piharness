[
  {
    "id": "ev-pin-pref",
    "name": "Pins an explicit preference",
    "split": "evolve",
    "tenant": {
      "tenantId": "eval-tenant",
      "userId": "eval-user",
      "permissions": [
        "memory:read",
        "memory:write",
        "artifacts:read",
        "skills:read",
        "domain:read",
        "domain:write",
        "domain:approve_request"
      ]
    },
    "evalPrompt": "Remember that I prefer concise answers.",
    "scriptedResponses": [
      {
        "type": "tool_calls",
        "calls": [
          {
            "name": "memory_pin",
            "arguments": {
              "key": "pref.style",
              "content": "Prefers concise answers",
              "kind": "preference"
            }
          }
        ]
      },
      {
        "type": "text",
        "text": "Pinned: you prefer concise answers."
      }
    ],
    "expectedToolNames": [
      "memory_pin"
    ],
    "expectedSubstrings": [
      "concise"
    ]
  },
  {
